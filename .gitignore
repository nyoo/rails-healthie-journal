# Local Bundler configuration and installed gems.
/.bundle/
/vendor/bundle/

# Logs and caches; retain directory placeholders.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/
/tmp/pids/*
!/tmp/pids/.keep
/coverage/

# Local secrets and environment overrides.
/.env*
!/.env.example
/config/*.key
/config/credentials/*.key

# Database dumps (keep schema.rb and migrations tracked).
*.dump
*.sql
*.sql.gz

# Editor and operating-system files.
.DS_Store
/.idea/
/.vscode/
*.swp
*.swo
*~
/.irb_history
/.byebug_history
