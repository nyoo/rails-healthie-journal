<h1>Clients</h1>

<table>
  <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Account Status</th><th>Created</th></tr></thead>
  <tbody>
    <% @clients.each do |client| %>
      <tr>
        <td><%= client.id %></td>
        <td><%= link_to client.name, client %></td>
        <td><%= client.email %></td>
        <td><span class="status <%= client.active? ? "active" : "inactive" %>"><%= account_status(client) %></span></td>
        <td><%= format_timestamp(client.created_at) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
